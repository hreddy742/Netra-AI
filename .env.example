# Netra AI — environment configuration
# Copy to .env and fill in your values

# ── System ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
MODEL_VERSION=1.0.0
LOGIC_VERSION=1.0.0

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=netra
POSTGRES_USER=netra
POSTGRES_PASSWORD=changeme

# ── SHM Ring Buffer ─────────────────────────────────────────
SHM_NUM_SLOTS=8
SHM_FRAME_HEIGHT=720
SHM_FRAME_WIDTH=1280

# ── Detection Models ────────────────────────────────────────
DETECTOR_MODEL_PATH=/models/yolo11s.pt
POSE_MODEL_PATH=/models/yolov8n-pose.pt          # fallback only
DETECTION_CONF=0.35
DETECTION_IOU=0.45
DETECTOR_DEVICE=cpu   # cpu | cuda | 0

# RTMPose-m ONNX pose estimator (phase-2.2)
POSE_ONNX_PATH=/models/rtmpose-m.onnx
POSE_USE_RTMPOSE=true
KEYPOINT_CONFIDENCE_MIN=0.3

# ── Tracking ────────────────────────────────────────────────
TRACKER_MAX_AGE=90           # 6 s at 15 FPS
TRACKER_MIN_HITS=2
TRACKER_IOU_THRESHOLD=0.3
TRACKER_USE_REID=true
REID_WEIGHTS_PATH=/models/osnet_x0_25_msmt17.pt

# ── Association / Zones ─────────────────────────────────────
ZONE_CONFIG_PATH=/config/zones.json
HAND_TO_HIP_DISTANCE_PX=110.0
N_FRAMES_HAND_IN_SHELF=4
CONCEAL_WINDOW_SEC=4.0
SPEED_SPIKE_MULTIPLIER=2.5

# ── FSM ─────────────────────────────────────────────────────
# DO NOT change signal weights without evaluation data (edgeguard-validated)
FSM_RISK_THRESHOLD=8.0
FSM_DECAY_RATE=1.8
FSM_SHOPFORMER_TRIGGER_SCORE=4.0

# ── ShopFormer ──────────────────────────────────────────────
SHOPFORMER_MODEL_PATH=/models/shopformer/transformer_best.pth
SHOPFORMER_GCAE_PATH=/models/shopformer/gcae_best.pth
SHOPFORMER_SEQ_LEN=24
SHOPFORMER_STRIDE=12
SHOPFORMER_NUM_KP=17
SHOPFORMER_LATENT_DIM=64
SHOPFORMER_NUM_HEADS=8
SHOPFORMER_NUM_LAYERS=4
SHOPFORMER_ANOMALY_THRESHOLD=0.60
SHOPFORMER_DEVICE=cpu

# ── Risk Engine ─────────────────────────────────────────────
RISK_WEIGHT_FSM=0.45
RISK_WEIGHT_SHOPFORMER=0.30
RISK_WEIGHT_INTERACTION=0.20
RISK_WEIGHT_CONTEXT=0.05
RISK_ALERT_THRESHOLD=0.65

# ── Evidence ────────────────────────────────────────────────
EVIDENCE_DIR=/data/evidence
CLIP_PRE_EVENT_SEC=10.0
CLIP_POST_EVENT_SEC=5.0
EVIDENCE_RETENTION_DAYS=30

# ── Alerting ────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=[]

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBERS=[]

WEBHOOK_ENABLED=false
WEBHOOK_URL=

# ── Gateway ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=   # REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
